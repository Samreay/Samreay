---
const TRACKING_ID = 'G-GRX6QE03YR';
const enabled = import.meta.env.PROD;
---
{enabled && (
  <>
    <script is:inline define:vars={{ TRACKING_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', TRACKING_ID, { send_page_view: false });
      gtag('event', 'page_view', {
        send_to: TRACKING_ID,
        page_location: window.location.href.split('#')[0],
        page_title: document.title,
        page_referrer: document.referrer,
      });

      let loaded = false;
      let scheduled = false;
      const listeners = new AbortController();

      const loadAnalytics = () => {
        if (loaded) return;
        loaded = true;
        clearTimeout(deadline);
        listeners.abort();
        const script = document.createElement('script');
        script.async = true;
        script.src = `https://www.googletagmanager.com/gtag/js?id=${TRACKING_ID}`;
        document.head.append(script);
      };

      const scheduleAnalytics = () => {
        if (loaded || scheduled || document.readyState === 'loading') return;
        // Astro removes `ssr` and emits `astro:hydrate` after an island hydrates.
        if (document.querySelector('astro-island[ssr][client="load"], astro-island[ssr][client="only"]')) return;
        scheduled = true;
        listeners.abort();
        requestAnimationFrame(() => requestAnimationFrame(() => {
          if (typeof window.requestIdleCallback === 'function') {
            window.requestIdleCallback(loadAnalytics, { timeout: 1000 });
          } else {
            setTimeout(loadAnalytics, 0);
          }
        }));
      };

      // Failed hydration or a background tab must not disable tracking forever.
      const deadline = setTimeout(loadAnalytics, 5000);
      document.addEventListener('DOMContentLoaded', scheduleAnalytics, { once: true, signal: listeners.signal });
      document.addEventListener('astro:hydrate', scheduleAnalytics, { capture: true, signal: listeners.signal });
      scheduleAnalytics();
    </script>
  </>
)}
