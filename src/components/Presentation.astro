---
interface Props {
  url: string;
  title: string;
}

const { url, title } = Astro.props;
---

<div class="presentation">
  <iframe src={url} title={title} loading="lazy" allowfullscreen></iframe>
</div>

<style>
  .presentation {
    width: 100%;
    aspect-ratio: 4 / 3;
    margin-inline: auto;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
